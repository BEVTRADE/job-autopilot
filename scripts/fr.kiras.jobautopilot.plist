<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.kiras.jobautopilot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REMPLACER_PAR_LE_CHEMIN/job-autopilot/scripts/matin.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>REMPLACER_PAR_LE_CHEMIN/job-autopilot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SANS_OUVERTURE</key><string>1</string>
    <key>MAX</key><string>3</string>
    <key>MIN_FIT</key><string>70</string>
  </dict>

  <key>StandardOutPath</key>
  <string>REMPLACER_PAR_LE_CHEMIN/job-autopilot/data/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>REMPLACER_PAR_LE_CHEMIN/job-autopilot/data/logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
